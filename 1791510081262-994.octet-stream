--[[
  BIMZ BYPASS EDITION
  Original: HOOK SURIKEN
  Modified by REDZ SPICY for Bos
  Credit: Bimz Bypass
  Fix: Crash on start / long load
  Feature: Antena Hand Kiri
]]

if (gg == nil) then os.exit(); end
gg.setVisible(false)
gg.sleep(500)

local STATE = {
    NARUTO   = false,
    SHURIKEN = false
}

-- Wrapper safe (pcall) biar nggak crash
local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        gg.toast("Error: " .. tostring(err))
        return false
    end
    return true
end

local function patchOn(fromHex, toHex, label)
    gg.clearResults()
    gg.sleep(150)
    gg.setRanges(0x20)
    gg.sleep(150)
    gg.searchNumber("h " .. fromHex, gg.TYPE_BYTE)
    gg.sleep(300)

    local count = gg.getResultsCount()
    if count > 0 then
        gg.getResults(count)
        gg.sleep(200)
        gg.editAll("h " .. toHex, gg.TYPE_BYTE)
        gg.sleep(200)
        gg.clearResults()
        gg.toast(label .. " ON")
        return true
    else
        gg.clearResults()
        gg.toast(label .. " FAILED")
        return false
    end
end

local function patchOff(fromHex, toHex, label)
    gg.clearResults()
    gg.sleep(150)
    gg.setRanges(0x20)
    gg.sleep(150)
    gg.searchNumber("h " .. fromHex, gg.TYPE_BYTE)
    gg.sleep(300)

    local count = gg.getResultsCount()
    if count > 0 then
        gg.getResults(count)
        gg.sleep(200)
        gg.editAll("h " .. toHex, gg.TYPE_BYTE)
        gg.sleep(200)
        gg.clearResults()
    end
    gg.toast(label .. " OFF")
end

local function narutoOn()
    if patchOn(
        "00 00 82 42 00 00 AA 42 1E 00 00 00",
        "0A D7 A3 3C 0A D7 A3 3C 0A D7 A3 3C",
        "NARUTO"
    ) then STATE.NARUTO = true end
end

local function narutoOff()
    patchOff(
        "0A D7 A3 3C 0A D7 A3 3C 0A D7 A3 3C",
        "00 00 82 42 00 00 AA 42 1E 00 00 00",
        "NARUTO"
    )
    STATE.NARUTO = false
end

local function shurikenOn()
    if patchOn(
        "00 00 00 41 00 00 b0 41 11 00 00 00",
        "0A D7 23 3C 0A D7 23 3C 0A D7 23 3C",
        "SHURIKEN"
    ) then STATE.SHURIKEN = true end
end

local function shurikenOff()
    patchOff(
        "0A D7 23 3C 0A D7 23 3C 0A D7 23 3C",
        "00 00 00 41 00 00 b0 41 11 00 00 00",
        "SHURIKEN"
    )
    STATE.SHURIKEN = false
end

-- ============================================
--  ANTENA HAND KIRI
-- ============================================
local function antenaHandKiri()
    setRanges(gg.REGION_CODE_APP)
    gg.searchNumber(" -8388395.5F;-8388393.5F;-8388387.5F ", gg.TYPE_FLOAT)
    gg.getResults( 5 )
    gg.editAll(" 999 ", gg.TYPE_FLOAT)
    gg.clearResults()
end

local function toggleAll()
    if STATE.NARUTO and STATE.SHURIKEN then
        narutoOff()
        shurikenOff()
    else
        if not STATE.NARUTO then narutoOn() end
        if not STATE.SHURIKEN then shurikenOn() end
    end
end

local function showMenu()
    local markNaruto   = (STATE.NARUTO   and "[ON]")  or "[OFF]"
    local markShuriken = (STATE.SHURIKEN and "[ON]")  or "[OFF]"
    local title = "BIMZ BYPASS\n" ..
                  "─────────────────\n" ..
                  "NARUTO: " .. markNaruto .. "  SHURIKEN: " .. markShuriken

    local choice = gg.choice({
        "NARUTO DAMAGE " .. markNaruto,
        "SHURIKEN DAMAGE " .. markShuriken,
        "TOGGLE ALL",
        "ANTENA HAND KIRI",
        "EXIT"
    }, nil, title)

    if choice == nil then return end

    if choice == 1 then
        safe(function() if STATE.NARUTO then narutoOff() else narutoOn() end end)
    elseif choice == 2 then
        safe(function() if STATE.SHURIKEN then shurikenOff() else shurikenOn() end end)
    elseif choice == 3 then
        safe(toggleAll)
    elseif choice == 4 then
        safe(antenaHandKiri)
    elseif choice == 5 then
        if STATE.NARUTO   then narutoOff()   end
        if STATE.SHURIKEN then shurikenOff() end
        gg.toast("BYE")
        os.exit()
    end
end

gg.sleep(300)
gg.toast("BIMZ BYPASS LOADED")
gg.sleep(300)

while true do
    if gg.isVisible(true) then
        gg.setVisible(false)
        gg.sleep(200)
        safe(showMenu)
    end
    gg.sleep(150)
end